-- luacheck configuration for Pardona's Buff Reminder (WoW Forever, Lua 5.1)
std = "lua51"
max_line_length = false
-- WoW callbacks receive parameters (self, event, button, ...) that are often unused
unused_args = false
exclude_files = { ".release", "Libs" }

-- Globals the addon writes
globals = {
    "BuffReminderDB",
    "BuffReminderCharDB",
    "SLASH_BUFFREMINDER1",
    "SLASH_BUFFREMINDER2",
    "SlashCmdList",
    "UISpecialFrames",
}

-- WoW API functions and objects the addon reads
read_globals = {
    -- namespaces
    "C_Container",
    "C_EventUtils",
    "C_AddOns",
    "C_CVar",
    "C_Item",
    "C_Minimap",
    "C_PetInfo",
    "C_Spell",
    "C_Texture",
    "C_SpellBook",
    "C_Timer",
    "C_TooltipInfo",
    "C_UnitAuras",
    -- frames and UI objects
    "CreateColor",
    "CreateFont",
    "CreateFrame",
    -- dropdowns (modern menu and legacy UIDropDownMenu; all calls checked at runtime)
    "MenuUtil",
    "UIDropDownMenu_Initialize",
    "UIDropDownMenu_SetWidth",
    "UIDropDownMenu_CreateInfo",
    "UIDropDownMenu_AddButton",
    "UIDropDownMenu_SetText",
    "UIDropDownMenu_EnableDropDown",
    "UIDropDownMenu_DisableDropDown",
    "CloseDropDownMenus",
    -- secure handler (keybinding one-shot; checked at runtime)
    "SecureHandlerWrapScript",
    "Enum",
    "GameTooltip",
    "LibStub",
    "UIParent",
    "SOUNDKIT",
    -- functions
    "GetAddOnInfo",
    "GetAddOnMetadata",
    "GetBindingKey",
    "GetBindingText",
    "ClearCursor",
    "ChatEdit_InsertLink",
    "GetCursorInfo",
    "GetInventorySlotInfo",
    "HandleModifiedItemClick",
    "hooksecurefunc",
    "GetCursorPosition",
    "GetCVar",
    "GetCVarBool",
    "GetInventoryItemID",
    "GetItemCount",
    "GetItemIcon",
    "GetItemInfo",
    "GetItemInfoInstant",
    "GetLocale",
    "GetMaxLevelForPlayerExpansion",
    "GetMaxPlayerLevel",
    "GetNumAddOns",
    "GetNormalizedRealmName",
    "GetNumGroupMembers",
    "GetNumTrackingTypes",
    "GetPhysicalScreenSize",
    "GetRealmName",
    "GetSpellInfo",
    "GetSpellTexture",
    "GetTime",
    "GetTrackingInfo",
    "GetTrackingTexture",
    "GetWeaponEnchantInfo",
    "HasPetUI",
    "InCombatLockdown",
    "IsAddOnLoaded",
    "IsInGroup",
    "IsInInstance",
    "IsInRaid",
    "IsMounted",
    "IsResting",
    "IsPlayerSpell",
    "IsXPUserDisabled",
    "MAX_PLAYER_LEVEL",
    "issecretvalue",
    "IsSpellKnown",
    "NUM_BAG_SLOTS",
    "NUM_TOTAL_EQUIPPED_BAG_SLOTS",
    "PanelTemplates_DeselectTab",
    "PanelTemplates_SelectTab",
    "PanelTemplates_TabResize",
    "PlaySound",
    "PlaySoundFile",
    "SetTracking",
    "tinsert",
    "UnitBuff",
    "UnitAffectingCombat",
    "UIErrorsFrame",
    "UnitClass",
    "UnitExists",
    "UnitGUID",
    "UnitInRange",
    "UnitInVehicle",
    "UnitIsConnected",
    "UnitIsDeadOrGhost",
    "UnitIsUnit",
    "UnitIsVisible",
    "UnitLevel",
    "UnitName",
    "time",
    "UnitOnTaxi",
    "WorldFrame",
    "Screenshot",
    -- vendor restock (all calls checked at runtime)
    "bit",
    "BuyMerchantItem",
    "C_CurrencyInfo",
    "C_MerchantFrame",
    "GetCoinTextureString",
    "GetContainerNumFreeSlots",
    "GetItemFamily",
    "GetMerchantItemID",
    "GetMerchantItemInfo",
    "GetMerchantItemLink",
    "GetMerchantItemMaxStack",
    "GetMerchantNumItems",
    "GetMoney",
    "MerchantFrame",
    "wipe",
}

-- Locale files: "L" stays unused until the CurseForge packager inserts the phrases
files["Locales/*.lua"] = { ignore = { "211/L" } }

-- Module files: every file starts with "local ADDON_NAME, ns = ..."; most of them only use ns
files["Modules/*.lua"] = { ignore = { "211/ADDON_NAME" } }
