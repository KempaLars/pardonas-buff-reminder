-- luacheck configuration for Pardona's Buff Reminder (WoW Forever, Lua 5.1)
std = "lua51"
max_line_length = false
-- WoW callbacks receive parameters (self, event, button, ...) that are often unused
unused_args = false
exclude_files = { ".release", "Libs" }

-- Globals the addon writes
globals = {
    "BuffReminderDB",
    "BuffReminderCharDB",
    "SLASH_BUFFREMINDER1",
    "SLASH_BUFFREMINDER2",
    "SlashCmdList",
    "UISpecialFrames",
}

-- WoW API functions and objects the addon reads
read_globals = {
    -- namespaces
    "C_Container",
    "C_EventUtils",
    "C_AddOns",
    "C_CVar",
    "C_Item",
    "C_Minimap",
    "C_Spell",
    "C_Texture",
    "C_SpellBook",
    "C_Timer",
    "C_TooltipInfo",
    "C_UnitAuras",
    -- frames and UI objects
    "CreateColor",
    "CreateFont",
    "CreateFrame",
    -- dropdowns (modern menu and legacy UIDropDownMenu; all calls checked at runtime)
    "MenuUtil",
    "UIDropDownMenu_Initialize",
    "UIDropDownMenu_SetWidth",
    "UIDropDownMenu_CreateInfo",
    "UIDropDownMenu_AddButton",
    "UIDropDownMenu_SetText",
    "UIDropDownMenu_EnableDropDown",
    "UIDropDownMenu_DisableDropDown",
    "CloseDropDownMenus",
    "Enum",
    "GameTooltip",
    "LibStub",
    "UIParent",
    "SOUNDKIT",
    -- functions
    "GetAddOnInfo",
    "GetAddOnMetadata",
    "GetBindingKey",
    "GetBindingText",
    "GetCursorPosition",
    "GetCVar",
    "GetCVarBool",
    "GetInventoryItemID",
    "GetItemCount",
    "GetItemIcon",
    "GetItemInfo",
    "GetItemInfoInstant",
    "GetLocale",
    "GetMaxLevelForPlayerExpansion",
    "GetMaxPlayerLevel",
    "GetNumAddOns",
    "GetNormalizedRealmName",
    "GetNumGroupMembers",
    "GetNumTrackingTypes",
    "GetPhysicalScreenSize",
    "GetRealmName",
    "GetSpellInfo",
    "GetSpellTexture",
    "GetTime",
    "GetTrackingInfo",
    "GetTrackingTexture",
    "GetWeaponEnchantInfo",
    "InCombatLockdown",
    "IsAddOnLoaded",
    "IsInGroup",
    "IsInInstance",
    "IsInRaid",
    "IsPlayerSpell",
    "IsXPUserDisabled",
    "MAX_PLAYER_LEVEL",
    "issecretvalue",
    "IsSpellKnown",
    "NUM_BAG_SLOTS",
    "PanelTemplates_DeselectTab",
    "PanelTemplates_SelectTab",
    "PanelTemplates_TabResize",
    "PlaySound",
    "SetTracking",
    "tinsert",
    "UnitBuff",
    "UnitClass",
    "UnitExists",
    "UnitGUID",
    "UnitInRange",
    "UnitInVehicle",
    "UnitIsConnected",
    "UnitIsDeadOrGhost",
    "UnitIsUnit",
    "UnitIsVisible",
    "UnitLevel",
    "UnitName",
    "time",
    "UnitOnTaxi",
    "WorldFrame",
    "Screenshot",
    "wipe",
}

-- Locale files: "L" stays unused until the CurseForge packager inserts the phrases
files["Locales/*.lua"] = { ignore = { "211/L" } }
